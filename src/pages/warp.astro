---
const features = [
  {
    title: "Directional Audio",
    text: "Uses multi-channel positional input when available, with stereo and mono fallback modes for broader compatibility.",
  },
  {
    title: "Bearing Radar",
    text: "Maps estimated sound direction, localization confidence, and fading contact history into a persistent top-down spatial display.",
  },
  {
    title: "Procedural Flight Space",
    text: "Transforms sound into reactive objects, trails, echoes, ripples, travelers, and rare spatial anomalies.",
  },
  {
    title: "Wearable Sensor Fusion",
    text: "A glasses-frame orientation model, wrap-safe smoothing, manual recentering, and depth-separated parallax keep the cockpit stable while the surrounding flight space responds to head movement.",
  },
  {
    title: "Calibration Lab",
    text: "Guided eight-sector calibration learns the real acoustic behavior of the wearable microphone array instead of assuming ideal geometry.",
  },
  {
    title: "Local by Design",
    text: "Environmental audio is processed on-device. Warp Lab does not record, upload, transmit, or transcribe what it hears.",
  },
];

const compatibility = [
  "Rokid RG-series waveguide glasses",
  "480 × 640 monochrome green display",
  "Android runtime with ADB access",
  "Microphone permission",
  "Game rotation vector / IMU support",
  "Windows development workflow",
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Apsis Warp Lab — spatial audio visualization for Rokid waveguide glasses."
    />

    <title>Warp Lab — Apsis</title>

    <style>
      :root {
        --bg: #070a0d;
        --bg-soft: #0c1116;
        --panel: rgba(17, 25, 32, 0.72);
        --panel-hover: rgba(22, 33, 41, 0.94);

        --text: #ecf3f0;
        --muted: #91a29b;
        --faint: #5e6f68;

        --accent: #7dffb2;
        --accent-soft: rgba(125,255,178,0.12);
        --line: rgba(125,255,178,0.18);

        --max-width: 1140px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;

        background:
          radial-gradient(
            circle at 70% -10%,
            rgba(82,170,123,0.08),
            transparent 38%
          ),
          linear-gradient(
            180deg,
            #070a0d 0%,
            #090d11 100%
          );

        color: var(--text);

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        min-height: 100vh;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;

        background-image:
          linear-gradient(
            rgba(125,255,178,0.022) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(125,255,178,0.022) 1px,
            transparent 1px
          );

        background-size: 48px 48px;

        mask-image:
          linear-gradient(
            to bottom,
            rgba(0,0,0,0.72),
            transparent 80%
          );
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .shell {
        width: min(calc(100% - 40px), var(--max-width));
        margin: 0 auto;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: 28px 0;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;

        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.28em;
      }

      .brand-mark {
        width: 9px;
        height: 9px;

        border: 1px solid var(--accent);
        border-radius: 50%;

        box-shadow:
          0 0 12px rgba(125,255,178,0.6),
          inset 0 0 5px rgba(125,255,178,0.35);
      }

      .back-link {
        color: var(--muted);
        font-size: 0.85rem;

        transition: color 160ms ease;
      }

      .back-link:hover {
        color: var(--accent);
      }

      .hero {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 40px;

        align-items: center;

        min-height: 76vh;
        padding: 80px 0 100px;
      }

      .eyebrow {
        margin-bottom: 22px;

        color: var(--accent);

        font-family:
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          monospace;

        font-size: 0.75rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;

        font-size: clamp(4.6rem, 10vw, 8rem);
        line-height: 0.9;
        letter-spacing: -0.06em;
      }

      .tagline {
        margin-top: 24px;

        color: var(--accent);

        font-size: 1.35rem;
      }

      .intro {
        max-width: 760px;

        margin-top: 28px;

        color: var(--muted);

        font-size: 1.08rem;
        line-height: 1.75;
      }

      .actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;

        margin-top: 34px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-height: 48px;
        padding: 0 22px;

        border: 1px solid var(--line);

        font-size: 0.9rem;
        font-weight: 600;

        transition:
          transform 160ms ease,
          background 160ms ease,
          border-color 160ms ease;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button.primary {
        background: var(--accent);
        border-color: var(--accent);

        color: #06100a;
      }

      .button.secondary {
        background: rgba(255,255,255,0.015);
      }

      .button.secondary:hover {
        background: var(--accent-soft);
        border-color: rgba(125,255,178,0.45);
      }

      .button.disabled {
        cursor: default;
        color: var(--muted);
        background: rgba(255,255,255,0.015);
        border-color: var(--line);
      }

      .button.disabled:hover {
        transform: none;
        background: rgba(255,255,255,0.015);
        border-color: var(--line);
      }

      .instrument-panel {
        position: relative;

        min-height: 470px;

        display: grid;
        place-items: center;

        overflow: hidden;

        border: 1px solid var(--line);

        background:
          radial-gradient(
            circle at center,
            rgba(125,255,178,0.06),
            transparent 58%
          ),
          rgba(8,13,16,0.58);
      }

      .instrument-label {
        position: absolute;
        top: 20px;
        left: 22px;

        color: var(--faint);

        font-family:
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 0.68rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .radar {
        position: relative;

        width: min(330px, 72%);
        aspect-ratio: 1;

        border: 1px solid rgba(125,255,178,0.34);
        border-radius: 50%;

        box-shadow:
          0 0 42px rgba(125,255,178,0.05),
          inset 0 0 40px rgba(125,255,178,0.035);

        overflow: hidden;
      }

      .ring,
      .axis,
      .center,
      .contact,
      .sweep {
        position: absolute;
      }

      .ring {
        left: 50%;
        top: 50%;

        border: 1px solid rgba(125,255,178,0.15);
        border-radius: 50%;

        transform: translate(-50%, -50%);
      }

      .ring.r1 {
        width: 32%;
        height: 32%;
      }

      .ring.r2 {
        width: 62%;
        height: 62%;
      }

      .ring.r3 {
        width: 88%;
        height: 88%;
      }

      .axis.horizontal {
        left: 0;
        top: 50%;

        width: 100%;
        height: 1px;

        background: rgba(125,255,178,0.10);
      }

      .axis.vertical {
        top: 0;
        left: 50%;

        width: 1px;
        height: 100%;

        background: rgba(125,255,178,0.10);
      }

      .center {
        left: 50%;
        top: 50%;

        width: 8px;
        height: 8px;

        transform: translate(-50%, -50%);

        border-radius: 50%;

        background: var(--accent);

        box-shadow: 0 0 13px rgba(125,255,178,0.8);
      }

      .contact {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: var(--accent);

        box-shadow: 0 0 10px rgba(125,255,178,0.62);
      }

      .c1 {
        left: 69%;
        top: 28%;
      }

      .c2 {
        left: 29%;
        top: 64%;
      }

      .c3 {
        left: 73%;
        top: 72%;
      }

      .c4 {
        left: 48%;
        top: 19%;

        background: transparent;
        border: 1px solid var(--accent);
      }

      .sweep {
        left: 50%;
        top: 50%;

        width: 50%;
        height: 2px;

        transform-origin: left center;

        background:
          linear-gradient(
            90deg,
            rgba(125,255,178,0.7),
            transparent
          );

        animation: sweep 6s linear infinite;
      }

      @keyframes sweep {
        from {
          transform: rotate(0deg);
        }

        to {
          transform: rotate(360deg);
        }
      }

      section {
        padding: 90px 0;
      }

      .section-label {
        margin-bottom: 18px;

        color: var(--accent);

        font-family:
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 0.74rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      h2 {
        margin: 0;

        font-size: clamp(2.2rem, 5vw, 4.2rem);
        line-height: 1.05;

        letter-spacing: -0.045em;
      }

      .copy {
        max-width: 780px;

        margin-top: 24px;

        color: var(--muted);

        font-size: 1.04rem;
        line-height: 1.75;
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;

        margin-top: 48px;
      }

      .feature {
        min-height: 220px;

        padding: 28px;

        border: 1px solid var(--line);

        background: var(--panel);

        transition:
          transform 170ms ease,
          border-color 170ms ease,
          background 170ms ease;
      }

      .feature:hover {
        transform: translateY(-4px);

        background: var(--panel-hover);
        border-color: rgba(125,255,178,0.42);
      }

      .feature-index {
        margin-bottom: 42px;

        color: var(--faint);

        font-family:
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 0.69rem;
      }

      .feature h3 {
        margin: 0 0 10px;

        font-size: 1.08rem;
      }

      .feature p {
        margin: 0;

        color: var(--muted);

        font-size: 0.93rem;
        line-height: 1.6;
      }

      .compatibility-grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 20px;

        margin-top: 46px;
      }

      .compatibility-panel,
      .status-panel {
        border: 1px solid var(--line);

        background: var(--bg-soft);
      }

      .compatibility-panel {
        padding: 34px;
      }

      .compatibility-panel ul {
        list-style: none;
        padding: 0;
        margin: 28px 0 0;
      }

      .compatibility-panel li {
        padding: 13px 0;

        border-bottom: 1px solid rgba(125,255,178,0.08);

        color: var(--muted);
      }

      .compatibility-panel li:last-child {
        border-bottom: 0;
      }

      .status-panel {
        padding: 34px;

        background:
          linear-gradient(
            135deg,
            rgba(125,255,178,0.07),
            rgba(125,255,178,0.015)
          );
      }

      .status-badge {
        display: inline-block;

        padding: 6px 9px;

        border: 1px solid var(--line);

        color: var(--accent);

        font-family:
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 0.68rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .status-panel h3 {
        margin: 28px 0 0;

        font-size: 1.8rem;
        letter-spacing: -0.03em;
      }

      .status-panel p {
        margin-top: 16px;

        color: var(--muted);
        line-height: 1.7;
      }

      .privacy {
        padding: 46px;

        border: 1px solid var(--line);

        background:
          linear-gradient(
            135deg,
            rgba(125,255,178,0.075),
            rgba(125,255,178,0.012)
          );
      }

      .privacy strong {
        color: var(--accent);
      }

      .release-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;

        margin-top: 28px;
      }

      footer {
        display: flex;
        justify-content: space-between;
        gap: 24px;

        margin-top: 80px;

        padding: 30px 0 50px;

        border-top: 1px solid var(--line);

        color: var(--faint);

        font-size: 0.78rem;
      }

      @media (max-width: 920px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .feature-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .compatibility-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .shell {
          width: min(calc(100% - 28px), var(--max-width));
        }

        .hero {
          min-height: auto;
          padding: 100px 0 70px;
        }

        .instrument-panel {
          min-height: 340px;
        }

        .feature-grid {
          grid-template-columns: 1fr;
        }

        .privacy {
          padding: 32px 24px;
        }

        footer {
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <div class="shell">
      <header>
        <a class="brand" href="/">
          <span class="brand-mark"></span>
          APSIS
        </a>

        <a class="back-link" href="/">
          ← Back to Apsis
        </a>
      </header>

      <main>
        <section class="hero">
          <div>
            <div class="eyebrow">
              Apsis Experimental Systems
            </div>

            <h1>Warp Lab</h1>

            <div class="tagline">
              Spatial audio made visible.
            </div>

            <p class="intro">
              Warp Lab is an experimental Android application for Rokid
              waveguide glasses that translates surrounding sound into a
              reactive spatial flight environment.
            </p>

            <div class="actions">
              <a
                class="button primary"
                href="https://github.com/ridderek/Apsis-Warp-Releases/releases/download/v0.4.6-community-preview/Apsis-Warp-Lab-v0.4.6-Community-Preview.apk"
              >
                Download v0.4.6
              </a>

              <a
                class="button secondary"
                href="https://github.com/ridderek/Apsis-Warp-Releases/releases/tag/v0.4.6-community-preview"
              >
                Release Notes
              </a>
            </div>
          </div>

          <div class="instrument-panel">
            <div class="instrument-label">
              Bearing monitor / live field
            </div>

            <div class="radar">
              <div class="ring r1"></div>
              <div class="ring r2"></div>
              <div class="ring r3"></div>

              <div class="axis horizontal"></div>
              <div class="axis vertical"></div>

              <div class="center"></div>

              <div class="contact c1"></div>
              <div class="contact c2"></div>
              <div class="contact c3"></div>
              <div class="contact c4"></div>

              <div class="sweep"></div>
            </div>
          </div>
        </section>

        <section>
          <div class="section-label">
            What it does
          </div>

          <h2>
            Sound becomes geometry.
          </h2>

          <p class="copy">
            Warp Lab analyzes sound intensity, frequency, duration, directional
            energy, arrival timing, and localization confidence. Those
            measurements drive luminous objects, trails, radar contacts, and
            cockpit instrumentation in real time.
          </p>

          <div class="feature-grid">
            {features.map((feature, index) => (
              <article class="feature">
                <div class="feature-index">
                  0{index + 1}
                </div>

                <h3>{feature.title}</h3>

                <p>{feature.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section>
          <div class="section-label">
            Hardware + status
          </div>

          <h2>
            Built for actual hardware.
          </h2>

          <div class="compatibility-grid">
            <div class="compatibility-panel">
              <h3>Current Compatibility</h3>

              <ul>
                {compatibility.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <div class="status-panel">
              <div class="status-badge">
                Community Preview
              </div>

              <h3>
                v0.4.6 validated on-device.
              </h3>

              <p>
                The current flight model has completed physical Rokid testing.
                Corrected attitude mapping, a stronger artificial horizon,
                manual recentering, and depth-separated parallax now join the
                established spatial-audio and Sonic Constellations systems.
              </p>
            </div>
          </div>
        </section>

        <section>
          <div class="privacy">
            <div class="section-label">
              Privacy
            </div>

            <h2>
              Nothing leaves the cockpit.
            </h2>

            <p class="copy">
              Warp Lab processes environmental audio locally and stores only
              numerical measurements needed for visualization and calibration.
              <strong>
                Audio is not recorded, transmitted, uploaded, or transcribed.
              </strong>
            </p>
          </div>
        </section>

        <section id="release">
          <div class="section-label">
            Release
          </div>

          <h2>
            Cleared for Community Preview.
          </h2>

          <p class="copy">
            Apsis Warp Lab v0.4.6 is now available as a signed Community
            Preview. The APK has completed on-glasses validation, uses the
            established Apsis Warp signing certificate, and is published
            separately from the private engineering source.
          </p>

          <div class="release-actions">
            <a
              class="button primary"
              href="https://github.com/ridderek/Apsis-Warp-Releases/releases/download/v0.4.6-community-preview/Apsis-Warp-Lab-v0.4.6-Community-Preview.apk"
            >
              Download APK
            </a>

            <a
              class="button secondary"
              href="https://github.com/ridderek/Apsis-Warp-Releases/releases/tag/v0.4.6-community-preview"
            >
              Release Notes
            </a>

            <a
              class="button secondary"
              href="https://github.com/ridderek/Apsis-Warp-Releases/releases/download/v0.4.6-community-preview/Apsis-Warp-Lab-v0.4.6-Community-Preview.apk.sha256"
            >
              SHA-256 Checksum
            </a>
          </div>
        </section>
      </main>

      <footer>
        <span>Apsis Warp Lab</span>
        <span>Less Cloud. More Gravity.</span>
      </footer>
    </div>
  </body>
</html>